{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedGemma Offline",
  "version": "1.0.0",
  "identifier": "com.nouman.medgemma.offline",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "MedGemma Offline", "width": 1100, "height": 780, "minWidth": 720, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
