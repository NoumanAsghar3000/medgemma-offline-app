{
  "compilerOptions": {
    "target": "ES2021", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "types": ["vite/client"], "isolatedModules": true, "noEmit": true
  },
  "include": ["src"]
}
